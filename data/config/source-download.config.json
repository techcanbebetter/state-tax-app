{
  "years": [2019, 2020, 2021, 2022, 2023],
  "year": 2023,
  "sources": {
    "tax": {
      "urlTemplate": "https://api.census.gov/data/timeseries/govs?get=NAME,GOVTYPE,GOVTYPE_LABEL,AGG_DESC,AGG_DESC_LABEL,AMOUNT,YEAR&for=state:*&time={year}&SVY_COMP=04",
      "description": "Census Annual Survey of State and Local Finance — one request per year"
    },
    "population": {
      "url": "https://www2.census.gov/programs-surveys/popest/datasets/2020-2023/state/totals/NST-EST2023-ALLDATA.csv",
      "description": "CSV source with state population values (multi-year wide format)"
    },
    "income": {
      "urlTemplate": "https://api.census.gov/data/{year}/acs/acs1?get=NAME,B19301_001E&for=state:*",
      "description": "Census ACS 1-year — Per capita income by state (B19301_001E) — one request per year"
    },
    "individualUnitFiles": {
      "description": "Census Individual Unit Files — state/local finance detail rows per year. Note: 2023 uses '_Files' (plural); 2019–2022 use '_File' (singular). Cannot be templated.",
      "urls": {
        "2019": "https://www2.census.gov/programs-surveys/gov-finances/tables/2019/2019_Individual_Unit_File.zip",
        "2020": "https://www2.census.gov/programs-surveys/gov-finances/tables/2020/2020_Individual_Unit_File.zip",
        "2021": "https://www2.census.gov/programs-surveys/gov-finances/tables/2021/2021_Individual_Unit_File.zip",
        "2022": "https://www2.census.gov/programs-surveys/gov-finances/tables/2022/2022_Individual_Unit_File.zip",
        "2023": "https://www2.census.gov/programs-surveys/gov-finances/tables/2023/2023_Individual_Unit_Files.zip"
      }
    },
    "f33": {
      "description": "Census F-33 K-12 finance data — district-level enrollment and expenditure by state",
      "urlTemplate": "https://www2.census.gov/programs-surveys/school-finances/tables/{year}/secondary-education-finance/elsec{yy}t.txt",
      "note": "yy is 2-digit year suffix: 2019→19, 2020→20, ..., 2023→23"
    }
  },
  "downloads": {
    "taxByYear": "data/raw/downloads/census-tax-source-{year}.json",
    "population": "data/raw/downloads/census-population-source.csv",
    "incomeByYear": "data/raw/downloads/census-acs-income-source-{year}.json",
    "individualUnitFileByYear": "data/raw/downloads/census-individual-unit-{year}.txt",
    "f33ByYear": "data/raw/downloads/census-f33-{year}.txt"
  },
  "normalization": {
    "tax": {
      "state": ["state", "State", "state_name", "NAME"],
      "year": ["year", "Year", "fiscal_year"],
      "taxType": ["tax_type", "Tax Type", "tax", "category"],
      "stateTaxRevenue": ["state_tax_revenue", "State Tax Revenue", "state_tax", "state_amount"],
      "localTaxRevenue": ["local_tax_revenue", "Local Tax Revenue", "local_tax", "local_amount"]
    },
    "population": {
      "state": ["state", "State", "state_name", "NAME"],
      "year": ["year", "Year"],
      "population": ["population", "Population", "pop", "POPESTIMATE", "POPESTIMATE2023", "POPESTIMATE2024"]
    }
  },
  "normalizedOutputs": {
    "tax": "data/raw/state-local-tax-by-type.csv",
    "population": "data/raw/state-population.csv",
    "income": "data/raw/state-per-capita-income.csv",
    "spending": "data/raw/state-local-spending-by-function.csv",
    "revenueExtended": "data/raw/state-local-revenue-extended.csv",
    "federalGrantsBreakdown": "data/raw/federal-grants-breakdown.csv",
    "f33": "data/raw/education-per-pupil.csv",
    "naep": "data/raw/naep-scores.csv",
    "reasonHighway": "data/raw/reason-highway-report.csv"
  }
}
